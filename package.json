{
  "name": "think_tank",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:dev": "NODE_ENV=development npx expo start --scheme THINKTANKDEV --dev-client -d",
    "start:staging": "NODE_ENV=staging npx expo start --scheme THINKTANKSTA --dev-client -d",
    "start:pro": "NODE_ENV=production npx expo start --scheme THINKTANKPRO --dev-client -d",
    "local:android:dev": "NODE_ENV=development expo run:android -d",
    "local:android:stag": "NODE_ENV=staging expo run:android -d",
    "local:android:pro": "NODE_ENV=production expo run:android -d",
    "local:ios:dev": "NODE_ENV=development expo run:ios -d",
    "local:ios:staging": "NODE_ENV=staging expo run:ios -d",
    "local:ios:pro": "NODE_ENV=production expo run:ios -d",
    "prebuild:ios:dev": "NODE_ENV=development npx expo prebuild --platform ios --clean",
    "prebuild:ios:staging": "NODE_ENV=staging npx expo prebuild --platform ios --clean",
    "prebuild:ios:pro": "NODE_ENV=production npx expo prebuild --platform ios --clean",
    "prebuild:android:dev": "NODE_ENV=development npx expo prebuild --platform android --clean",
    "prebuild:android:staging": "NODE_ENV=staging npx expo prebuild --platform android --clean",
    "prebuild:android:pro": "NODE_ENV=production npx expo prebuild --platform android --clean"
  },
  "dependencies": {
    "@expo/config": "^9.0.3",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-firebase/app": "^21.7.1",
    "@react-native-firebase/auth": "^21.7.1",
    "@react-native-firebase/crashlytics": "^21.7.1",
    "@react-native-firebase/messaging": "^21.7.1",
    "@react-native-masked-view/masked-view": "^0.3.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@tanstack/react-query": "^5.56.2",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "expo": "~51.0.28",
    "expo-build-properties": "~0.12.5",
    "expo-dev-client": "^4.0.27",
    "expo-linear-gradient": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-bouncy-checkbox": "^4.1.2",
    "react-native-gesture-handler": "^2.18.1",
    "react-native-reanimated": "^3.15.1",
    "react-native-safe-area-context": "^4.10.9",
    "react-native-screens": "^3.34.0",
    "react-native-svg": "^15.7.1",
    "react-native-toast-message": "^2.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "^5.1.3"
  },
  "private": true
}
